# WebPent environment template
# Copy to .env and replace every CHANGE-ME value before production use.
# Never commit .env, real API keys, credentials, cookies, or callback secrets.

# --- Runtime and LLM -------------------------------------------------------
LLM_ENABLED=false
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
DEBUG=false
MAX_GRAPH_STEPS=50
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=llama3.1:8b
ZAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GITHUB_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- Feature flags: all optional/high-impact features are off by default ----
ENABLE_TARGET_UNDERSTANDING=false
ENABLE_ATTACK_GRAPH=false
ENABLE_ADAPTIVE_HUNT=false
ENABLE_WORKFLOW_UNDERSTANDING=false
ENABLE_PLANNER_DECISIONS=false
ENABLE_AUTHORIZATION_MATRIX=false
ENABLE_JS_INTELLIGENCE=false
ENABLE_REPORT_QUALITY_GATE=false
ENABLE_BUG_BOUNTY_REPORTER=false
ENABLE_STRUCTURE_AWARE_TRIAGE=false
ENABLE_SURFACE_SECURITY_ANALYSIS=false
ENABLE_MEMORY_BOUNDARY=false
MAX_PLANNER_DECISION_COST=10.0

# --- HTTP, scope, and transport safety -------------------------------------
HTTP_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10
HTTP_USER_AGENT=WebPent/0.2 (+https://github.com/example/webpent)
ALLOW_INSECURE_TLS=false

# --- External tools --------------------------------------------------------
NMAP_PATH=nmap
NIKTO_PATH=nikto
SQLMAP_PATH=sqlmap
NUCLEI_PATH=nuclei
FFUF_PATH=ffuf
FFUF_ENABLED=false
# Required when FFUF_ENABLED=true; use a local, trusted wordlist path.
FFUF_WORDLIST_PATH=
GOBUSTER_PATH=gobuster
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx-pd
ZAP_PATH=/usr/share/zaproxy/zap.sh
KATANA_PATH=katana
DALFOX_PATH=dalfox
YSOSERIAL_PATH=ysoserial.jar
PHPGGC_PATH=phpggc
NUCLEI_TIMEOUT=600
FFUF_TIMEOUT=300
SQLMAP_TIMEOUT=300
SQLMAP_POST_TIMEOUT=10
DALFOX_TIMEOUT=300

# --- Storage and RAG -------------------------------------------------------
OUTPUT_DIR=./output
DATABASE_URL=sqlite:///./webpent.db
# Optional: survive worker restarts with encrypted records in shared SQLite.
# Keep disabled unless API and workers share this database and CELERY_PAYLOAD_KEY.
WEBPENT_REAUTH_VAULT_SHARED_STORE=false
# Leave empty to reuse DATABASE_URL; use a separate shared sqlite:/// URL if desired.
WEBPENT_REAUTH_VAULT_DATABASE_URL=
EMBEDDINGS_OFFLINE=false
DISABLE_RAG=false

# --- Bounded concurrency and business-logic budgets ------------------------
GOVERNOR_MAX_CONCURRENT=4
GOVERNOR_ERROR_RATE_THRESHOLD=0.35
BUSINESS_LOGIC_BURST_SIZE=3
BUSINESS_LOGIC_MAX_ENDPOINTS=10

# --- OOB confirmation (disabled unless both values are configured) ----------
OOB_CALLBACK_BASE_URL=
OOB_CALLBACK_SECRET=
OOB_POLL_TIMEOUT_SECONDS=3.0
MOCK_OOB_SERVER_URL=http://127.0.0.1:18099

# --- Stealth budgets -------------------------------------------------------
STEALTH_JITTER_MIN=2.0
STEALTH_JITTER_MAX=5.0
STEALTH_MIN_REQUEST_INTERVAL=1.0

# --- Webhook integration ---------------------------------------------------
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_TIMEOUT=10.0
# Required when WEBHOOK_ENABLED=true. Use a high-entropy random value.
WEBHOOK_SECRET=CHANGE-ME-WEBHOOK-HMAC-SECRET

# --- API authentication and task protection -------------------------------
# Deployment posture: lab preserves local compatibility; staging/production
# require AUTH_ENABLED=true and strong secrets.
ENVIRONMENT_PROFILE=lab
# Required for staging/production checkpoint persistence; prevents unsafe msgpack reconstruction.
LANGGRAPH_STRICT_MSGPACK=true
# AUTH_ENABLED=true is mandatory for any public/non-local deployment.
AUTH_ENABLED=false
JWT_SECRET_KEY=CHANGE-ME-generate-a-random-secret
AUDIT_SECRET_KEY=CHANGE-ME-generate-a-random-secret
CELERY_PAYLOAD_KEY=CHANGE-ME-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Production compose requires this and does not provide a default.
WEBPENT_USERS=CHANGE-ME:CHANGE-ME:admin

# CORS must be explicit in production; wildcard is for local development only.
# Canonical compose name; CORS_ORIGINS remains a supported Settings alias.
WEBPENT_CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_ENABLED=false
RATE_LIMIT_SCAN_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=60
RATE_LIMIT_REDIS_URL=
TRUSTED_PROXY_IPS=["127.0.0.1"]

# --- Celery/Redis ----------------------------------------------------------
# Local development only. Production compose does not start Redis internally.
WEBPENT_REDIS_URL=redis://localhost:6379/0

# docker-compose.yml production requirements. Use externally managed Redis
# endpoints with TLS and certificate verification; do not use redis:// here.
REDIS_URL=rediss://CHANGE-ME-redis-host:6379/0
RATE_LIMIT_REDIS_URL=rediss://CHANGE-ME-redis-host:6379/1
WEBPENT_API_HOST=0.0.0.0
# Production compose sets this to true and fails fast if bind-mount ownership cannot be reconciled.
WEBPENT_FAIL_ON_OWNERSHIP_ERROR=false

# --- Optional compatibility aliases accepted by selected settings ----------
# WEBPENT_LLM_ENABLED=false
# WEBPENT_FFUF_ENABLED=false
# WEBPENT_FFUF_WORDLIST_PATH=
# WEBPENT_CELERY_PAYLOAD_KEY=CHANGE-ME
# WEBPENT_ALLOW_INSECURE_TLS=false

# --- Deliberately unsafe local-only preflight override ----------------------
# Do not set this in production. It only bypasses the public insecure posture
# guard for an explicitly understood local/lab deployment.
# I_UNDERSTAND_THIS_IS_INSECURE=true

# --- Task-router provider reference (models/base URLs) ----------------------
# The router skips empty keys and walks the configured fallback chain. Exact
# chains are printed by `webpent preflight` without making LLM API calls.
#
# Groq        https://api.groq.com/openai/v1        llama-3.3-70b-versatile
# OpenRouter  https://openrouter.ai/api/v1          meta-llama/llama-3.3-70b-instruct:free
# Cerebras    https://api.cerebras.ai/v1            llama3.1-70b
# GitHub      https://models.inference.ai.azure.com  gpt-4o / gpt-4o-mini
# Z.AI        https://open.bigmodel.cn/api/paas/v4/ glm-5.1 / glm-4.7-flash
# Anthropic   provider SDK endpoint                  claude-sonnet-5
# Gemini      provider SDK endpoint                  gemini-2.0-flash
# Mistral     provider SDK endpoint                  mistral-large-latest
# Cohere      provider SDK endpoint                  command-r-plus / command-r
# Cloudflare  Workers AI endpoint                   @cf/meta/llama-3-8b-instruct
# Local       http://localhost:11434/v1             model depends on Ollama/local runtime
#
# DEFAULT_LLM_MODEL is used by legacy single-provider paths. The task router
# uses tested bounded model slugs by default, with OPENAI_MODEL and
# LOCAL_LLM_MODEL as explicit overrides. OPENAI_BASE_URL supports OpenAI or a
# compatible endpoint; LOCAL_LLM_URL is configurable because local servers
# differ by installation. Set LOCAL_LLM_ENABLED=true only when that endpoint
# is healthy and intentionally part of the fallback chain.

# --- Cost, quota, and fallback guidance ------------------------------------
# Free tiers, model names, retention, and rate limits change. Check each
# provider's current dashboard and terms before enabling it in production.
# Keep at least two eligible providers configured when cloud fallback matters.
# Fallback means another configured provider is attempted after a provider
# failure; it does not guarantee zero cost or unlimited quota.
# For a deterministic run with no cloud LLM calls, use:
#   webpent scan --url https://authorized-target.example --no-llm
# For a read-only provider/fallback audit with no LLM request, use:
#   webpent preflight
# Local Ollama is a quota-free option but consumes local CPU/GPU/RAM.
# OpenRouter `:free`, Groq, GitHub Models, and Cerebras may have eligibility
# and rate limits; verify current availability instead of assuming permanence.
